{
  // Esquema validación
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  // Opciones logo
  "logo": {
    "type": "builtin",
    "source": "fedora",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  
  // Ajustes visuales
  "display": {
    "separator": " ",
    "color": {
      "keys": "yellow"
    }
  },
  
  // Lista módulos
  "modules": [
    // Salto línea
    "break",
    
    // Título Hardware
    {
      "type": "custom",
      "format": "┌──────────────── Hardware ────────────────┐",
      "outputColor": "white"
    },
    
    // Módulo RAM
    {
      "type": "memory",
      "key": "│  ",
      "keyColor": "yellow"
    },
    
    // Módulo disco
    {
      "type": "disk",
      "key": "│  󰋊",
      "keyColor": "yellow"
    },
    
    // Borde inferior
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "white"
    },
    
    // Salto línea
    "break",
    
    // Título Software
    {
      "type": "custom",
      "format": "┌──────────────── Software ────────────────┐",
      "outputColor": "white"
    },
    
    // Sistema operativo
    {
      "type": "os",
      "key": "│  󰣇",
      "keyColor": "blue"
    },
    
    // Versión kernel
    {
      "type": "kernel",
      "key": "│  󰒋",
      "keyColor": "blue"
    },
    
    // Tipo shell
    {
      "type": "shell",
      "key": "│  󱆃",
      "keyColor": "blue"
    },
    
    // Entorno escritorio
    {
      "type": "de",
      "key": "│  󰧨",
      "keyColor": "blue"
    },
    
    // Emulador terminal
    {
      "type": "terminal",
      "key": "│  ",
      "keyColor": "blue"
    },
    
    // Borde inferior
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "white"
    },
    
    // Salto línea
    "break",
    
    // Título Uptime
    {
      "type": "custom",
      "format": "┌─────────────── Uptime / Age ─────────────┐",
      "outputColor": "white"
    },
    
    // Tiempo activo
    {
      "type": "uptime",
      "key": "│  󱎫",
      "keyColor": "magenta"
    },
    
    // Borde inferior
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
      "outputColor": "white"
    }
  ]
}
