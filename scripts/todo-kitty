#!/usr/bin/env bash

TODO_FILE="$HOME/.todo.tex"
CACHE_DIR="$HOME/.cache/kitty-todo-latex"
mkdir -p "$CACHE_DIR"

if [ ! -f "$TODO_FILE" ]; then
    cat <<EOF > "$TODO_FILE"
\task Resolver la ecuación de onda: $\nabla^2 \psi = \frac{1}{v^2} \frac{\partial^2 \psi}{\partial t^2}$
\done Revisar los apuntes de la integral: $\int_0^\infty e^{-x^2} dx = \frac{\sqrt{\pi}}{2}$
\task Tarea normal sin LaTeX
EOF
fi

echo -e "\033[1;34mTAREAS PENDIENTES\033[0m\n"

id=1

while read -u 3 -r line; do
    if [[ "$line" =~ ^\s*\\done ]]; then
        box="[x]"
        strike_start="\033[9m"  
        strike_end="\033[0m"
    else
        box="[ ]"
        strike_start=""
        strike_end=""
    fi

    task_content=$(echo "$line" | sed -E 's/^\s*\\(task|done)\s*//')
    
    hash=$(echo -n "$task_content" | md5sum | awk '{print $1}')
    img_path="$CACHE_DIR/$hash.png"

    if [[ "$task_content" =~ \$.*\$ ]]; then
        if [ ! -f "$img_path" ]; then
            tex_file="$CACHE_DIR/$hash.tex"
            
            echo '\documentclass[preview,border=2pt]{standalone}' > "$tex_file"
            echo '\usepackage[utf8]{inputenc}' >> "$tex_file"
            echo '\usepackage{amsmath,amsfonts,mathtools,amsthm,amssymb,mathrsfs,stmaryrd,bm,bbm}' >> "$tex_file"
            echo '\usepackage{xcolor}' >> "$tex_file"
            echo '\usepackage{cmbright}' >> "$tex_file"
            echo '\renewcommand{\implies}{\Rightarrow}' >> "$tex_file"
            echo '\renewcommand{\impliedby}{\Leftarrow}' >> "$tex_file"
            echo '\renewcommand{\iff}{\Leftrightarrow}' >> "$tex_file"
            echo '\begin{document}' >> "$tex_file"
            echo '\color{white}' >> "$tex_file"
            echo "$task_content" >> "$tex_file"
            echo '\end{document}' >> "$tex_file"

            pdflatex -interaction=nonstopmode -output-directory="$CACHE_DIR" "$tex_file" >/dev/null 2>&1
            pdftocairo -png -transp -singlefile "$CACHE_DIR/$hash.pdf" "$CACHE_DIR/$hash" >/dev/null 2>&1
            
            rm -f "$CACHE_DIR/$hash.aux" "$CACHE_DIR/$hash.log" "$CACHE_DIR/$hash.pdf" "$CACHE_DIR/$hash.tex"
        fi

        if [ -s "$img_path" ]; then
            echo -e " \033[34m$id.\033[0m $box"
            kitty +kitten icat --align left --transfer-mode=file "$img_path" < /dev/tty
        else
            echo -e " \033[34m$id.\033[0m $box ${strike_start}$task_content${strike_end} \033[31m(Error compilando LaTeX)\033[0m"
        fi
    else
        echo -e " \033[34m$id.\033[0m $box ${strike_start}$task_content${strike_end}"
    fi

    ((id++))
done 3< <(grep -E '^\s*\\(task|done)\s+' "$TODO_FILE")

echo ""
